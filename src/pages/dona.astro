---
// Donar — la página de conversión económica.
import Base from '../layouts/Base.astro';
import { t, tr, idiomaDe, formatearNumero } from '../lib/idioma';
import { paginas, configuracion, rutaDeImagen } from '../lib/contenido';

const p = paginas.dona;
const idioma = idiomaDe(Astro);

const METODOS: Record<string, string> = {
  tarjeta: 'Tarjeta', spei: 'SPEI', oxxo: 'OXXO Pay',
  domiciliacion: 'Domiciliación', paypal: 'PayPal',
};
const metodos = p.metodosDePago ?? [];
// La pasarela solo existe si el equipo la marcó como activa en el panel.
const pasarela = p.pasarela?.discriminant ? p.pasarela.value : null;

/** Fondo tenue del color elegido, con el icono en el tono fuerte. */
const TENUE: Record<string, string> = {
  coral: 'background:rgba(244,98,98,.14);color:var(--coral-d)',
  azul: 'background:rgba(66,128,191,.14);color:var(--azul)',
  teal: 'background:rgba(43,114,104,.14);color:var(--teal)',
  menta: 'background:rgba(73,182,166,.16);color:var(--teal)',
  mango: 'background:rgba(255,162,49,.2);color:#a05c00',
  vino: 'background:rgba(155,53,79,.14);color:var(--vino)',
};
const fondoTenue = (color?: string) => TENUE[color ?? 'coral'] ?? TENUE.coral;

---

<Base seo={p.seo} ruta="emocional">
  <section class="pad-s" style="padding-top:clamp(40px,5vw,72px)">
    <div class="wrap" style="text-align:center;max-width:760px">
      <span class="eyebrow" style="color:var(--coral-d)"><span class="dot"></span> {t(p.antetitulo, idioma)}</span>
      <h1 class="h1" style="margin:16px auto 18px;max-width:16ch" set:html={tr(p.titulo, idioma)} />
      <p class="lead" style="margin:0 auto" set:html={tr(p.entrada, idioma)} />
    </div>
  </section>

  <section class="pad-s">
    <div class="wrap" style="max-width:940px">
      <div class="grid g3">
        {(p.montos ?? []).map((m: any) => (
          <Fragment>
            {m.enlace ? (
              <a class:list={['amount', m.destacado && 'sel']} href={m.enlace} rel="noopener">
                {m.destacado && <span class="ribbon">{idioma === 'en' ? 'Most chosen' : 'Más elegido'}</span>}
                <div class="amt">
                  ${formatearNumero(m.monto, idioma)}<span style="font-size:.9rem;font-weight:600"> MXN</span>
                </div>
                <div class="per">
                  {m.periodicidad === 'unico'
                    ? (idioma === 'en' ? 'one time' : 'donativo único')
                    : (idioma === 'en' ? 'per month' : 'al mes')}
                </div>
                <p class="does">{t(m.equivalencia, idioma)}</p>
                <span class="link-arrow" style="color:var(--coral-d);margin-top:14px;display:inline-flex">
                  {idioma === 'en' ? 'Donate this amount' : 'Donar este monto'}
                </span>
              </a>
            ) : (
              <div class:list={['amount', m.destacado && 'sel']}>
                {m.destacado && <span class="ribbon">{idioma === 'en' ? 'Most chosen' : 'Más elegido'}</span>}
                <div class="amt">
                  ${formatearNumero(m.monto, idioma)}<span style="font-size:.9rem;font-weight:600"> MXN</span>
                </div>
                <div class="per">
                  {m.periodicidad === 'unico'
                    ? (idioma === 'en' ? 'one time' : 'donativo único')
                    : (idioma === 'en' ? 'per month' : 'al mes')}
                </div>
                <p class="does">{t(m.equivalencia, idioma)}</p>
              </div>
            )}
          </Fragment>
        ))}
      </div>

      <div class="form" style="margin-top:34px">
        <div class="grid g2" style="gap:26px;align-items:center">
          <div>
            <h3 class="h3" style="margin-bottom:10px">{idioma === 'en' ? 'Payment methods' : 'Formas de pago'}</h3>
            {metodos.length > 0 ? (
              <div style="display:flex;gap:8px;flex-wrap:wrap">
                {metodos.map((m: string) => (
                  <span class:list={['tag', m === 'paypal' ? 'tag-mango' : 'tag-teal']}>{METODOS[m] ?? m}</span>
                ))}
              </div>
            ) : (
              <p class="small muted">{idioma === 'en' ? 'Coming soon.' : 'Por confirmar.'}</p>
            )}
          </div>
          <div>
            {pasarela?.enlace ? (
              <Fragment>
                <a href={pasarela.enlace} class="btn btn-coral" style="width:100%" rel="noopener">
                  {t(pasarela.textoBoton, idioma) || (idioma === 'en' ? 'Donate now' : 'Donar ahora')}
                </a>
                {t(pasarela.nota, idioma) && (
                  <p class="small muted" style="margin-top:12px;text-align:center">{t(pasarela.nota, idioma)}</p>
                )}
              </Fragment>
            ) : (
              <Fragment>
                <p class="small muted" style="margin-bottom:16px">
                  {idioma === 'en'
                    ? 'The donation gateway is being set up. Meanwhile, write to us and we will guide you.'
                    : 'La pasarela de donativos está en preparación. Mientras tanto, escríbenos y te orientamos.'}
                </p>
                {configuracion.contacto?.correo && (
                  <a href={`mailto:${configuracion.contacto.correo}`} class="btn btn-coral" style="width:100%">
                    {idioma === 'en' ? 'I want to donate' : 'Quiero donar'}
                  </a>
                )}
              </Fragment>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pad-s" style="padding-bottom:clamp(64px,9vw,110px)">
    <div class="wrap grid g3">
      {(p.garantias ?? []).map((g: any) => (
        <div class="card">
          <div class="icon-chip" style={fondoTenue(g.color)} aria-hidden={g.iconoImagen ? undefined : 'true'}>
              {g.iconoImagen ? <img src={rutaDeImagen(g.iconoImagen)} alt="" /> : g.icono}
            </div>
          <h4>{t(g.titulo, idioma)}</h4>
          <p>{t(g.descripcion, idioma)}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
