---
// Qué es Clown Care — la página que explica el método.
// Mismo patrón que index.astro: ningún texto visible se escribe aquí.
import Base from '../layouts/Base.astro';
import { t, tr, idiomaDe, idDeYouTube } from '../lib/idioma';
import { paginas, imagenPublicable, rutaDeImagen } from '../lib/contenido';

const p = paginas.clownCare;
const idioma = idiomaDe(Astro);
const videoVisible = imagenPublicable(p.video?.portada);
const videoId = idDeYouTube(p.video?.enlace);

/** Fondo tenue del color elegido, con el icono en el tono fuerte. */
const TENUE: Record<string, string> = {
  coral: 'background:rgba(244,98,98,.14);color:var(--coral-d)',
  azul: 'background:rgba(66,128,191,.14);color:var(--azul)',
  teal: 'background:rgba(43,114,104,.14);color:var(--teal)',
  menta: 'background:rgba(73,182,166,.16);color:var(--teal)',
  mango: 'background:rgba(255,162,49,.2);color:#a05c00',
  vino: 'background:rgba(155,53,79,.14);color:var(--vino)',
};
const fondoTenue = (color?: string) => TENUE[color ?? 'coral'] ?? TENUE.coral;
---

<Base seo={p.seo} ruta="institucional">
  <section class="pad-s" style="padding-top:clamp(40px,5vw,72px)">
    <div class="wrap">
      <span class="eyebrow" style="color:var(--azul)">
        <span class="dot" style="background:var(--azul)"></span> {t(p.antetitulo, idioma)}
      </span>
      <h1 class="h1" style="margin:16px 0 20px;max-width:16ch" set:html={tr(p.titulo, idioma)} />
      <p class="lead" style="font-size:1.2rem" set:html={tr(p.entrada, idioma)} />
    </div>
  </section>

  {videoVisible && (
    <section class="pad-s">
      <div class="wrap">
        {videoId ? (
          <button
            class="video-fachada photo duo-azul dots-bg filled"
            style="aspect-ratio:21/9;border-radius:var(--r-xl)"
            data-video={videoId}
            aria-label={`${idioma === 'en' ? 'Play video' : 'Reproducir video'}: ${t(p.video.portada.textoAlternativo, idioma)}`}
          >
            <img class="slot-img" src={rutaDeImagen(p.video.portada.archivo)} alt={t(p.video.portada.textoAlternativo, idioma)} loading="lazy" />
            <span class="video-play"><span aria-hidden="true">▶</span></span>
          </button>
        ) : (
          <div class="photo duo-azul dots-bg filled" style="aspect-ratio:21/9;border-radius:var(--r-xl)">
            <img class="slot-img" src={rutaDeImagen(p.video.portada.archivo)} alt={t(p.video.portada.textoAlternativo, idioma)} loading="lazy" />
          </div>
        )}
        {t(p.video?.pie, idioma) && <p class="small muted" style="margin-top:14px">{t(p.video.pie, idioma)}</p>}
      </div>
    </section>
  )}

  {t(p.poderDelEncuentro?.titulo, idioma) && (
    <section class="pad-s">
      <div class="wrap">
        <h2 class="h2" style="margin-bottom:32px;max-width:20ch" set:html={tr(p.poderDelEncuentro.titulo, idioma)} />
        <div class="grid g4 ejes">
          {(p.poderDelEncuentro?.ejes ?? []).map((e: any) => (
            <div class="card">
              <div class="icon-chip" style={fondoTenue(e.color)} aria-hidden={e.iconoImagen ? undefined : 'true'}>
                {e.iconoImagen
                  ? <img src={rutaDeImagen(e.iconoImagen)} alt="" />
                  : e.icono}
              </div>
              <h4>{t(e.titulo, idioma)}</h4>
              <p>{t(e.descripcion, idioma)}</p>
            </div>
          ))}
        </div>
        {t(p.poderDelEncuentro?.nota, idioma) && (
          <div style="margin-top:34px;padding-top:24px;border-top:1px solid rgba(19,46,42,.12)">
            <p class="muted" style="margin:0;max-width:68ch">
              {t(p.poderDelEncuentro.nota, idioma)}
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="pad">
    <div class="wrap grid g2" style="gap:clamp(32px,5vw,64px)">
      <div>
        <h2 class="h2" style="margin-bottom:18px" set:html={tr(p.anatomia?.titulo, idioma)} />
        <p class="lead" set:html={tr(p.anatomia?.entrada, idioma)} />
        {t(p.anatomia?.frase, idioma) && (
          <blockquote style="margin:30px 0 0;padding-left:20px;border-left:3px solid var(--coral);font-family:var(--display);font-size:clamp(1.25rem,2.2vw,1.7rem);line-height:1.28;letter-spacing:-.02em;color:var(--tinta-60);max-width:22ch">
            {t(p.anatomia.frase, idioma)}
          </blockquote>
        )}
      </div>
      <div>
        {(p.anatomia?.pasos ?? []).map((paso: any, i: number) => (
          <div class="method-row">
            <div class="method-n">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h4>{t(paso.titulo, idioma)}</h4>
              <p>{t(paso.descripcion, idioma)}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pad-s">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:32px;max-width:20ch" set:html={tr(p.acompanamos?.titulo, idioma)} />
      <div class="grid g2">
        {(p.acompanamos?.grupos ?? []).map((g: any) => (
          <div class="card">
            <div class="icon-chip" style={fondoTenue(g.color)} aria-hidden={g.iconoImagen ? undefined : 'true'}>
              {g.iconoImagen
                ? <img src={rutaDeImagen(g.iconoImagen)} alt="" />
                : g.icono}
            </div>
            <h4>{t(g.titulo, idioma)}</h4>
            <p>{t(g.descripcion, idioma)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {t(p.visitasVirtuales?.titulo, idioma) && (
    <section class="pad-s">
      <div class="wrap">
        <div
          class="card split3"
          style="display:grid;grid-template-columns:auto 1fr auto;gap:26px;align-items:center;padding:34px;background:linear-gradient(135deg,rgba(73,182,166,.14),rgba(255,162,49,.14));border-color:transparent"
        >
          <div
            class="icon-chip"
            style="background:var(--menta);color:#fff;width:58px;height:58px;border-radius:50%"
            aria-hidden="true"
          >
            💻
          </div>
          <div>
            <h3 class="h3" style="margin-bottom:6px">{t(p.visitasVirtuales.titulo, idioma)}</h3>
            <p class="muted small">{t(p.visitasVirtuales.descripcion, idioma)}</p>
          </div>
          {t(p.visitasVirtuales.boton?.texto, idioma) && (
            <a href={p.visitasVirtuales.boton.destino} class="btn btn-teal" style="flex:none">
              {t(p.visitasVirtuales.boton.texto, idioma)}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="pad-s" style="padding-bottom:clamp(64px,9vw,110px)">
    <div class="wrap">
      <div class="cta-final" style="background:var(--teal)">
        <span class="confetti" style="width:110px;height:110px;background:#fff;left:8%;top:16%;opacity:.12"></span>
        <span class="confetti" style="width:60px;height:60px;background:var(--mango);right:12%;bottom:18%;opacity:.6"></span>
        <div style="position:relative">
          <h2 class="h1" style="color:#fff" set:html={tr(p.llamadoHospitales?.titulo, idioma)} />
          <p style="color:rgba(255,255,255,.8)" set:html={tr(p.llamadoHospitales?.cuerpo, idioma)} />
          {t(p.llamadoHospitales?.boton?.texto, idioma) && (
            <div style="margin-top:30px">
              <a href={p.llamadoHospitales.boton.destino} class="btn btn-white">{t(p.llamadoHospitales.boton.texto, idioma)}</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
  <script>
    // Al pulsar la portada se inserta el reproductor. Antes de ese clic no se
    // carga nada de YouTube: ninguna visita al sitio envía datos a Google sin
    // que el visitante lo haya decidido.
    document.querySelectorAll<HTMLButtonElement>('.video-fachada').forEach((fachada) => {
      fachada.addEventListener('click', () => {
        const id = fachada.dataset.video;
        if (!id) return;
        const marco = document.createElement('iframe');
        marco.className = 'video-marco';
        // Dominio sin cookies de seguimiento.
        marco.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        marco.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        marco.allowFullscreen = true;
        marco.title = fachada.getAttribute('aria-label') ?? 'Video';
        fachada.replaceChildren(marco);
      });
    });
  </script>

<style>
  /* Las tarjetas de los ejes bajan a una columna en teléfono. El .g4 compartido
     se queda en dos porque otras páginas lo usan para botones cortos —los
     informes anuales, por ejemplo—, donde dos columnas sí funcionan. */
  @media (max-width: 620px) {
    .ejes { grid-template-columns: 1fr; }
  }
</style>
</Base>
