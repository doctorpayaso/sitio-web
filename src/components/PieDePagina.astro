---
// Pie de página del prototipo aprobado. Todo sale de "Ajustes generales":
// ningún dato de contacto está escrito en el código.
import { t, idiomaDe, formatearFecha } from '../lib/idioma';
import { configuracion, cifras } from '../lib/contenido';

const idioma = idiomaDe(Astro);
const anio = new Date().getFullYear();
const c = configuracion.contacto ?? {};

const REDES: Record<string, string> = {
  facebook: 'FB', instagram: 'IG', linkedin: 'in', tiktok: 'TT', youtube: 'YT',
};
const redes = Object.entries(configuracion.redes ?? {}).filter(([, url]) => Boolean(url));

const participa = [
  { es: 'Certifícate', en: 'Get certified', url: '/certificate' },
  { es: 'Donar', en: 'Donate', url: '/dona' },
  { es: 'Alianzas', en: 'Partnerships', url: '/alianzas' },
];
const conoce = [
  { es: 'Qué es Clown Care', en: 'What is Clown Care', url: '/clown-care' },
  { es: 'Impacto y transparencia', en: 'Impact and transparency', url: '/impacto' },
  { es: 'Contacto', en: 'Contact', url: '/contacto' },
];
const rotulo = (e: Record<string, string>) => e[idioma] ?? e.es;
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a href="/" class="logo" aria-label="Doctor Payaso A.C. — Inicio">
          <img class="logo-img" src="/logo.svg" alt="Doctor Payaso A.C." width="220" height="56" />
        </a>
        <p class="slogan">{t(configuracion.eslogan, idioma)}</p>
        <p class="small" style="max-width:34ch;margin-bottom:20px">
          {t(configuracion.descripcionBreve, idioma)}
        </p>
        {redes.length > 0 && (
          <div class="social">
            {redes.map(([nombre, url]) => (
              <a href={url as string} target="_blank" rel="noopener noreferrer" aria-label={nombre}>
                {REDES[nombre] ?? nombre.slice(0, 2).toUpperCase()}
              </a>
            ))}
          </div>
        )}
      </div>

      <div>
        <h5>{idioma === 'en' ? 'Take part' : 'Participa'}</h5>
        {participa.map((e) => <a href={e.url}>{rotulo(e)}</a>)}
      </div>

      <div>
        <h5>{idioma === 'en' ? 'Learn more' : 'Conoce'}</h5>
        {conoce.map((e) => <a href={e.url}>{rotulo(e)}</a>)}
      </div>

      <div>
        <h5>{idioma === 'en' ? 'Contact' : 'Contacto'}</h5>
        {c.correo && <a href={`mailto:${c.correo}`}>{c.correo}</a>}
        {c.telefono && <a href={`tel:${String(c.telefono).replace(/\s/g, '')}`}>{c.telefono}</a>}
        {c.whatsapp && (
          <a href={`https://wa.me/${String(c.whatsapp).replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        )}
        {configuracion.avisoDePrivacidad && (
          <a href={configuracion.avisoDePrivacidad}>
            {idioma === 'en' ? 'Privacy notice' : 'Aviso de privacidad'}
          </a>
        )}
        <a href="/impacto">{idioma === 'en' ? 'Annual reports' : 'Informes anuales'}</a>
      </div>
    </div>

    <div class="foot-bottom">
      <span>
        &copy; {anio} Doctor Payaso A.C.
        {configuracion.donataria?.numeroAutorizacion && (
          <> · {idioma === 'en' ? 'Authorized donee' : 'Donataria autorizada'}</>
        )}
      </span>
      {cifras.fechaDeCorte && (
        <span>
          {idioma === 'en' ? 'Figures as of' : 'Cifras a'}{' '}
          {formatearFecha(cifras.fechaDeCorte, idioma, { month: 'long', year: 'numeric' })}
        </span>
      )}
    </div>
  </div>
</footer>
