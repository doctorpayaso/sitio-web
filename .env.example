# =============================================================================
#  Doctor Payaso A.C. — Variables de entorno
#
#  Copiar como .env para desarrollo local. NUNCA subir el .env al repositorio.
#  En producción, cargarlas en el panel de Cloudflare, no en un archivo.
# =============================================================================

# --- Panel de edición (Keystatic) --------------------------------------------
# Se generan solas la primera vez que se corre `npm run dev` y se sigue el
# asistente de conexión con GitHub. No hay que inventarlas.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Formularios (Fase 4) ----------------------------------------------------
# Credencial del rol limitado que SOLO puede insertar en el esquema `web`.
# No es la llave de servicio del proyecto. Si se filtrara, no permite leer nada.
SUPABASE_URL=
SUPABASE_WEB_INSERT_KEY=

# --- Antispam (Fase 4) -------------------------------------------------------
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Notificaciones (Fase 4) -------------------------------------------------
RESEND_API_KEY=
