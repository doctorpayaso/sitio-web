---
// Botón / enlace de acción. Único componente que produce llamadas a la acción,
// para que el estilo y el comportamiento de foco sean idénticos en todo el sitio.
import { t, idiomaDe } from '../lib/idioma';
import type { TextoLocalizado } from '../lib/idioma';

interface Props {
  texto?: TextoLocalizado;
  destino?: string | null;
  variante?: 'principal' | 'secundario' | 'fantasma';
}

const { texto, destino, variante = 'principal' } = Astro.props;
const idioma = idiomaDe(Astro);
const etiqueta = t(texto, idioma);

// Un botón sin texto o sin destino no se dibuja: es preferible un hueco a un
// enlace roto que el visitante descubre al hacer clic.
const visible = Boolean(etiqueta && destino);
const externo = destino?.startsWith('http');
---

{
  visible && (
    <a
      class:list={['boton', `boton--${variante}`]}
      href={destino}
      {...(externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {etiqueta}
      {externo && <span class="solo-lectores">(se abre en una ventana nueva)</span>}
    </a>
  )
}

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    border: 2px solid transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    /* Mínimo de 44px de alto: requisito de accesibilidad para uso táctil. */
    min-height: 44px;
  }

  .boton:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .boton--principal {
    background: var(--coral);
    color: var(--papel);
  }
  .boton--principal:hover {
    background: var(--coral-d);
  }

  /* En páginas institucionales la acción principal cambia de familia cromática. */
  :global([data-ruta='institucional']) .boton--principal {
    background: var(--teal);
  }
  :global([data-ruta='institucional']) .boton--principal:hover {
    background: #1f574f;
  }

  .boton--secundario {
    background: transparent;
    color: var(--tinta);
    border-color: var(--tinta-30);
  }
  .boton--secundario:hover {
    border-color: var(--tinta);
  }

  .boton--fantasma {
    background: transparent;
    color: var(--tinta-80);
    padding-inline: 0.25rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
