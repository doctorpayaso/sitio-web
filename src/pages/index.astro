---
// =============================================================================
//  Inicio — portada
//
//  Portada fiel al prototipo aprobado por Dirección en agosto de 2026.
//  Nueve secciones: hero, franja de prueba, doble ruta, método, cita editorial,
//  visitas virtuales, transparencia, testimonio, aliados y cierre.
//
//  ESTA PÁGINA ES EL PATRÓN. Las otras cinco se construyen igual:
//   1. importar la página desde lib/contenido
//   2. resolver el idioma una vez
//   3. envolver todo texto en t()
//   4. no escribir NUNCA un texto visible directamente aquí
//
//  Si un texto está escrito en este archivo, la Administradora no lo puede
//  cambiar. Ese es el criterio único para decidir qué va en el panel.
// =============================================================================

import Base from '../layouts/Base.astro';
import { t, tr, enriquecer, idiomaDe, formatearFecha, formatearNumero } from '../lib/idioma';
import {
  paginas,
  cifras,
  aliados,
  proximaGeneracion,
  sedePorId,
  testimonioPorId,
  imagenPublicable,
} from '../lib/contenido';

const p = paginas.inicio;
const idioma = idiomaDe(Astro);

const generacion = p.hero?.mostrarProximaGeneracion ? proximaGeneracion() : null;
const sedeGeneracion = sedePorId(generacion?.sede);
const MODALIDAD: Record<string, { es: string; en: string }> = {
  presencial: { es: 'presencial', en: 'in person' },
  virtual: { es: 'virtual', en: 'online' },
  mixta: { es: 'mixta', en: 'hybrid' },
};
const testimonio = testimonioPorId(p.testimonio?.persona);
const listaAliados = aliados();

// --- Franja de prueba --------------------------------------------------------
// Las cifras las elige la Administradora desde el panel; aquí solo se resuelven
// contra el registro único de cifras.
const ETIQUETAS: Record<string, { es: string; en: string }> = {
  voluntariosCertificados: { es: 'Voluntarios certificados', en: 'Certified volunteers' },
  voluntariosActivos: { es: 'Voluntarios certificados activos', en: 'Active certified volunteers' },
  visitasHospitalarias: { es: 'Visitas a hospitales', en: 'Hospital visits' },
  personasBeneficiadas: { es: 'Personas beneficiadas', en: 'People reached' },
  ciudadesConOperacion: { es: 'Ciudades con operación permanente', en: 'Cities with permanent operations' },
  informesPublicados: { es: 'Informes anuales publicados', en: 'Annual reports published' },
  rangoDeEdad: {
    es: 'Rango de edad de los pacientes que acompañamos',
    en: 'Age range of the patients we accompany',
  },
};

const franja = (p.franjaDeCifras ?? [])
  .map((clave: string) => ({
    clave,
    valor: (cifras as any)[clave],
    etiqueta: ETIQUETAS[clave]?.[idioma as 'es'] ?? ETIQUETAS[clave]?.es ?? clave,
  }))
  .filter((c: any) => c.valor !== undefined && c.valor !== null && c.valor !== '');

/**
 * Arma el titular: respeta los saltos de línea que escribió el equipo y pinta
 * de coral la palabra elegida. Se construye como HTML porque el titular
 * necesita etiquetas dentro del texto, no alrededor.
 */
function armarTitular(titular: string, palabra: string): string {
  const html = enriquecer(titular);
  if (!palabra) return html;
  const acento = enriquecer(palabra);
  if (!html.includes(acento)) return html;
  return html.replace(acento, `<span class="accent">${acento}</span>`);
}
const titularHtml = armarTitular(
  t(p.hero?.titulo, idioma),
  t(p.hero?.palabraDestacada, idioma),
);

const heroVisible = imagenPublicable(p.hero?.imagen);
const metodoVisible = imagenPublicable(p.metodo?.imagen);
const testimonioVisible = imagenPublicable(p.testimonio?.imagen);
---

<Base seo={p.seo} ruta="emocional">
  <!-- ===================================================================== -->
  <!--  HERO                                                                  -->
  <!-- ===================================================================== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        {p.hero?.antetitulo && (
          <span class="eyebrow" style="color:var(--coral-d)">
            <span class="dot"></span> {t(p.hero.antetitulo, idioma)}
          </span>
        )}

        <h1 class="h-hero" set:html={titularHtml} />

        <p class="lead" set:html={tr(p.hero?.entrada, idioma)} />

        <div class="hero-cta">
          {t(p.hero?.botonPrincipal?.texto, idioma) && (
            <a href={p.hero.botonPrincipal.destino} class="btn btn-coral">
              {t(p.hero.botonPrincipal.texto, idioma)}
            </a>
          )}
          {t(p.hero?.botonSecundario?.texto, idioma) && (
            <a href={p.hero.botonSecundario.destino} class="btn btn-ghost">
              {t(p.hero.botonSecundario.texto, idioma)}
            </a>
          )}
        </div>

        {generacion && (
          <div class="next-gen">
            <span class="pulse"></span>
            {idioma === 'en' ? 'Next cohort' : 'Próxima generación'}{' '}
            {MODALIDAD[generacion.modalidad]?.[idioma as 'es'] ?? MODALIDAD[generacion.modalidad]?.es}:{' '}
            <strong>
              {sedeGeneracion?.nombre ? `${sedeGeneracion.nombre} · ` : ''}
              {formatearFecha(generacion.fechaDeInicio, idioma)}
            </strong>
          </div>
        )}

        {t(p.hero?.firma, idioma) && <p class="firma">{t(p.hero.firma, idioma)}</p>}
      </div>

      <div class="hero-photo-wrap">
        <div class:list={['photo', 'photo-hero', 'duo-coral', 'dots-bg', heroVisible && 'filled']}>
          {heroVisible && (
            <img
              class="slot-img"
              src={p.hero.imagen.archivo}
              alt={t(p.hero.imagen.textoAlternativo, idioma)}
              loading="eager"
            />
          )}
        </div>

        {p.hero?.insignia?.numero && (
          <div class="badge-float">
            <div class="n">
              {formatearNumero(p.hero.insignia.numero, idioma)}<span style="color:var(--coral)">+</span>
            </div>
            <div class="t" set:html={tr(p.hero.insignia.etiqueta, idioma)} />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!--  FRANJA DE PRUEBA                                                      -->
  <!-- ===================================================================== -->
  {franja.length > 0 && (
    <section class="proof">
      <div class="wrap">
        <div class="proof-grid">
          {franja.map((c: any) => (
            <div class="proof-item">
              <div class="n">
                {c.clave === 'rangoDeEdad' ? (
                  String(c.valor)
                ) : (
                  <Fragment>{formatearNumero(c.valor, idioma)}<em>+</em></Fragment>
                )}
              </div>
              <div class="t">{c.etiqueta}</div>
            </div>
          ))}
        </div>
        {cifras.fechaDeCorte && (
          <p class="proof-corte">
            {idioma === 'en' ? 'Figures as of' : 'Cifras a'}{' '}
            {formatearFecha(cifras.fechaDeCorte, idioma, { month: 'long', year: 'numeric' })}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- ===================================================================== -->
  <!--  DOBLE RUTA                                                            -->
  <!-- ===================================================================== -->
  <section class="pad">
    <div class="wrap">
      <div style="max-width:60ch;margin-bottom:44px">
        <span class="eyebrow" style="color:var(--teal)">
          <span class="dot" style="background:var(--teal)"></span> {t(p.dosRutas?.antetitulo, idioma)}
        </span>
        <h2 class="h2" style="margin:14px 0" set:html={tr(p.dosRutas?.titulo, idioma)} />
        <p class="lead" set:html={tr(p.dosRutas?.entrada, idioma)} />
      </div>

      <div class="routes">
        {[
          { datos: p.dosRutas?.rutaPersonas, clase: 'route-a' },
          { datos: p.dosRutas?.rutaInstituciones, clase: 'route-b' },
        ].map(({ datos, clase }) =>
          datos ? (
            <article class:list={['route', clase]}>
              <span class="ring ring1"></span>
              <span class="ring ring2"></span>
              <span class="route-tag">{t(datos.etiqueta, idioma)}</span>
              <h3>{t(datos.titulo, idioma)}</h3>
              <p>{t(datos.descripcion, idioma)}</p>
              <ul>
                {(datos.puntos ?? []).map((punto: any) => <li>{t(punto, idioma)}</li>)}
              </ul>
              <div class="foot">
                <a href={datos.boton?.destino} class="btn btn-white">{t(datos.boton?.texto, idioma)}</a>
              </div>
            </article>
          ) : null,
        )}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!--  MÉTODO                                                                -->
  <!-- ===================================================================== -->
  <section
    class="pad"
    style="background:var(--papel);border-top:1px solid var(--tinta-12);border-bottom:1px solid var(--tinta-12)"
  >
    <div class="wrap">
      <div class="grid g2" style="gap:clamp(32px,5vw,72px);align-items:center">
        <div
          class:list={['photo', 'duo-mixto', 'dots-bg', metodoVisible && 'filled']}
          style="aspect-ratio:1/1;border-radius:var(--r-xl)"
        >
          {metodoVisible && (
            <img
              class="slot-img"
              src={p.metodo.imagen.archivo}
              alt={t(p.metodo.imagen.textoAlternativo, idioma)}
              loading="lazy"
            />
          )}
        </div>

        <div>
          <span class="eyebrow" style="color:var(--azul)">
            <span class="dot" style="background:var(--azul)"></span> {t(p.metodo?.antetitulo, idioma)}
          </span>
          <h2 class="h2" style="margin:14px 0 20px" set:html={tr(p.metodo?.titulo, idioma)} />
          <p class="lead" style="margin-bottom:28px" set:html={tr(p.metodo?.entrada, idioma)} />

          {(p.metodo?.pasos ?? []).map((paso: any, i: number) => (
            <div class="method-row">
              <div class="method-n">{String(i + 1).padStart(2, '0')}</div>
              <div>
                <h4>{t(paso.titulo, idioma)}</h4>
                <p>{t(paso.descripcion, idioma)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!--  CITA EDITORIAL                                                        -->
  <!-- ===================================================================== -->
  {t(p.citaEditorial?.texto, idioma) && (
    <section class="pad-s">
      <div class="wrap">
        <div class="quote">
          <span class="quote-mark" aria-hidden="true">&rdquo;</span>
          <blockquote>{t(p.citaEditorial.texto, idioma)}</blockquote>
          <cite set:html={tr(p.citaEditorial.autor, idioma)} />
        </div>
      </div>
    </section>
  )}

  <!-- ===================================================================== -->
  <!--  VISITAS VIRTUALES                                                     -->
  <!-- ===================================================================== -->
  {t(p.visitasVirtuales?.titulo, idioma) && (
    <section class="pad-s">
      <div class="wrap">
        <div
          class="card split3"
          style="display:grid;grid-template-columns:auto 1fr auto;gap:26px;align-items:center;padding:34px;background:linear-gradient(135deg,rgba(73,182,166,.14),rgba(255,162,49,.14));border-color:transparent"
        >
          <div
            class="icon-chip"
            style="background:var(--menta);color:#fff;width:58px;height:58px;border-radius:50%"
            aria-hidden="true"
          >
            💻
          </div>
          <div>
            <h3 class="h3" style="margin-bottom:6px">{t(p.visitasVirtuales.titulo, idioma)}</h3>
            <p class="muted small">{t(p.visitasVirtuales.descripcion, idioma)}</p>
          </div>
          {t(p.visitasVirtuales.boton?.texto, idioma) && (
            <a href={p.visitasVirtuales.boton.destino} class="btn btn-teal" style="flex:none">
              {t(p.visitasVirtuales.boton.texto, idioma)}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ===================================================================== -->
  <!--  TRANSPARENCIA                                                         -->
  <!-- ===================================================================== -->
  <section class="pad">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:40px">
        <div style="max-width:52ch">
          <span class="eyebrow" style="color:var(--teal)">
            <span class="dot" style="background:var(--teal)"></span> {t(p.transparencia?.antetitulo, idioma)}
          </span>
          <h2 class="h2" style="margin:14px 0 12px" set:html={tr(p.transparencia?.titulo, idioma)} />
          <p class="lead" set:html={tr(p.transparencia?.entrada, idioma)} />
        </div>
        {t(p.transparencia?.enlace?.texto, idioma) && (
          <a href={p.transparencia.enlace.destino} class="link-arrow" style="color:var(--teal)">
            {t(p.transparencia.enlace.texto, idioma)}
          </a>
        )}
      </div>

      <div class="grid g4">
        {(p.transparencia?.tarjetas ?? []).map((tarjeta: any) => (
          <div class="card">
            <div class="num" style={tarjeta.color ? `color:var(--${tarjeta.color})` : undefined}>
              {t(tarjeta.destacado, idioma)}
            </div>
            <h4>{t(tarjeta.titulo, idioma)}</h4>
            <p>{t(tarjeta.descripcion, idioma)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!--  TESTIMONIO                                                            -->
  <!-- ===================================================================== -->
  {testimonio && (
    <section class="pad-s">
      <div class="wrap grid g2" style="align-items:center;gap:clamp(28px,4vw,56px)">
        <div
          class:list={['photo', 'duo-mango', 'dots-bg', testimonioVisible && 'filled']}
          style="aspect-ratio:4/3;border-radius:var(--r-xl)"
        >
          {testimonioVisible && (
            <img
              class="slot-img"
              src={p.testimonio.imagen.archivo}
              alt={t(p.testimonio.imagen.textoAlternativo, idioma)}
              loading="lazy"
            />
          )}
        </div>

        <div>
          <span class="eyebrow" style="color:var(--vino)">
            <span class="dot" style="background:var(--vino)"></span> {t(p.testimonio?.antetitulo, idioma)}
          </span>
          <blockquote style="font-family:var(--display);font-size:clamp(1.3rem,2.4vw,1.9rem);line-height:1.3;letter-spacing:-.02em;margin:18px 0 22px;color:var(--tinta-60)">
            {t(testimonio.cita, idioma)}
          </blockquote>
          <p class="small" style="font-weight:700">
            {testimonio.nombre}
            {testimonio.institucion ? ` · ${testimonio.institucion}` : ''}
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- ===================================================================== -->
  <!--  ALIADOS                                                               -->
  <!-- ===================================================================== -->
  {listaAliados.length > 0 && (
    <section class="pad-s">
      <div class="wrap">
        <p class="eyebrow muted" style="display:block;text-align:center;margin-bottom:26px">
          {t(p.aliados?.titulo, idioma)}
        </p>
        <div class="logos">
          {listaAliados.map((a: any) => (
            <div class="logo-box">
              {a.logotipo ? <img src={a.logotipo} alt={a.nombre} loading="lazy" /> : a.nombre}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===================================================================== -->
  <!--  CIERRE                                                                -->
  <!-- ===================================================================== -->
  <section class="pad-s" style="padding-bottom:clamp(64px,9vw,120px)">
    <div class="wrap">
      <div class="cta-final">
        <span class="confetti" style="width:120px;height:120px;background:var(--coral);left:6%;top:14%"></span>
        <span class="confetti" style="width:70px;height:70px;background:var(--mango);right:9%;top:22%"></span>
        <span class="confetti" style="width:44px;height:44px;background:var(--menta);right:22%;bottom:16%"></span>
        <span class="confetti" style="width:90px;height:90px;background:var(--azul);left:16%;bottom:8%"></span>

        <div style="position:relative">
          <h2 class="h1" set:html={tr(p.cierre?.titulo, idioma)} />
          <p set:html={tr(p.cierre?.descripcion, idioma)} />
          {t(p.cierre?.firma, idioma) && (
            <p style="font-family:var(--display);font-style:italic;font-size:1.15rem;color:var(--mango);margin-top:22px">
              {t(p.cierre.firma, idioma)}
            </p>
          )}
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px">
            {t(p.cierre?.botonPrincipal?.texto, idioma) && (
              <a href={p.cierre.botonPrincipal.destino} class="btn btn-coral">
                {t(p.cierre.botonPrincipal.texto, idioma)}
              </a>
            )}
            {t(p.cierre?.botonSecundario?.texto, idioma) && (
              <a href={p.cierre.botonSecundario.destino} class="btn btn-ghost-light">
                {t(p.cierre.botonSecundario.texto, idioma)}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
