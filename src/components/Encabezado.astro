---
// Navegación principal, portada del prototipo aprobado.
import { idiomaDe } from '../lib/idioma';
// Se importa en lugar de apuntar a /logo.svg. Así el compilador lo empaqueta
// con nombre versionado en /_astro/, la misma ruta por la que salen los estilos.
// Un archivo suelto en public/ depende de que el hospedaje lo copie tal cual;
// un archivo importado es parte de la compilación y no se puede perder.
import logoUrl from '../assets/logo.svg?url';

const idioma = idiomaDe(Astro);
const aqui = Astro.url.pathname.replace(/\/$/, '') || '/';

const enlaces = [
  // El botón «Quiero ser voluntario» salió de aquí: apuntaba a /certificate,
  // el mismo destino que la entrada «Certifícate», con otro nombre, y el CSS
  // lo escondía en teléfono. Ocupaba justo el espacio que faltaba para que
  // cupieran las entradas que pidió el Comité.
  { es: 'Inicio', en: 'Home', url: '/' },
  // Descomentar en cuanto exista la página; hoy sería un enlace a un 404.
  // { es: 'Nuestra misión', en: 'Our mission', url: '/mision' },
  { es: 'Clown care', en: 'Clown care', url: '/clown-care' },
  { es: 'Certifícate', en: 'Get certified', url: '/certificate' },
  { es: 'Alianzas', en: 'Partnerships', url: '/alianzas' },
  { es: 'Impacto', en: 'Impact', url: '/impacto' },
  { es: 'Dona', en: 'Donate', url: '/dona' },
  { es: 'Contacto', en: 'Contact', url: '/contacto' },
];

const activo = (url: string) => (url === '/' ? aqui === '/' : aqui.startsWith(url));
const rotulo = (e: Record<string, string>) => e[idioma] ?? e.es;
---

<header class="nav">
  <div class="nav-in">
    <a href="/" class="logo" aria-label="Doctor Payaso A.C. — Inicio">
      <img class="logo-img" src={logoUrl} alt="Doctor Payaso A.C." width="160" height="40" />
    </a>

    <nav class="nav-links" id="menu" aria-label="Navegación principal">
      {enlaces.map((e) => (
        <a href={e.url} aria-current={activo(e.url) ? 'page' : undefined}>{rotulo(e)}</a>
      ))}
    </nav>

    <div class="nav-cta">
      <a href="/dona" class="btn btn-coral btn-sm">{idioma === 'en' ? 'Donate' : 'Donar'}</a>
    </div>

    <button class="burger" id="burger" aria-label="Menú" aria-expanded="false" aria-controls="menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');

  burger?.addEventListener('click', () => {
    const abierto = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!abierto));
    menu?.classList.toggle('open', !abierto);
  });

  // Cerrar con Escape: quedar atrapado en un menú abierto navegando con teclado
  // es de las fallas de accesibilidad más comunes y más fáciles de evitar.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      burger.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('open');
      burger.focus();
    }
  });
</script>
